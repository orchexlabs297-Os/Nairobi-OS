# ── Supabase ──────────────────────────────────────────────────────────────
# Ve a tu proyecto en https://supabase.com/dashboard/project/bvuotcicefdjirgrxgfp
# → Project Settings → API, y copia estos dos valores.
# NUNCA copies aquí el "service_role key" — solo el "anon public" key.
# El anon key es seguro de exponer en el frontend porque RLS controla el acceso.

VITE_SUPABASE_URL=https://bvuotcicefdjirgrxgfp.supabase.co
VITE_SUPABASE_ANON_KEY=pega-aqui-tu-anon-public-key

# ── n8n (API App Web — W8) ───────────────────────────────────────────────
# Endpoint real: POST https://<tu-instancia-n8n>/webhook/nairobi-os-4d8e1f-api/:resource
# Recursos ya implementados en W8 que este panel usa: bot-toggle (pausar/
# reactivar a Nai por conversación). El panel NUNCA escribe directo a
# Supabase — todo pasa por n8n, que es el único escritor (service_role).
VITE_N8N_APP_WEB_URL=https://tu-instancia-n8n/webhook/nairobi-os-4d8e1f-api
# Header x-app-web-secret — el mismo valor que la credencial "API App Web"
# en n8n (httpHeaderAuth). NUNCA el service_role key de Supabase.
VITE_N8N_APP_WEB_SECRET=pega-aqui-el-secreto-compartido-con-n8n

# ── Modo demo ─────────────────────────────────────────────────────────────
# Ponlo en "true" SOLO para probar la interfaz localmente sin Supabase
# configurado (sin login real, usando datos de ejemplo). Déjalo en "false"
# o bórralo antes de desplegar a producción.
VITE_ALLOW_DEMO=false
